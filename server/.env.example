OPENFY_ENV=dev
# Container fallback copied to /app/.env in the image. Real container paths
# come from Dockerfile ENV + compose environment: (both /data/...), which win
# over this file. Kept consistent so a plain `docker run` still lands on the volume.
OPENFY_DATABASE_URL=sqlite:////data/openfy.db
OPENFY_DATA_DIR=/data
OPENFY_MUSIC_DIR=/data/music
OPENFY_DOWNLOADS_DIR=/data/downloads
OPENFY_ARTWORK_DIR=/data/artwork
OPENFY_ALLOWED_ORIGINS=*
# Seeds the initial registration mode only; change it in the dashboard afterwards.
OPENFY_REGISTRATION_MODE=invite
# Pin SpotiFLAC to a specific version (e.g. 0.7.0). Leave empty for latest.
SPOTIFLAC_PIN_VERSION=
OPENFY_ADMIN_USERNAME=admin
# From the repository root: python scripts/generate_hash.py
OPENFY_ADMIN_HASH=
