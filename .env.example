OPENFY_ENV=dev
OPENFY_ADMIN_USERNAME=admin
# Generate a random credential with: python scripts/generate_hash.py
OPENFY_ADMIN_HASH=
OPENFY_ALLOWED_ORIGINS=http://localhost:8000
OPENFY_MAX_UPLOAD_SIZE_MB=200
# Paths use built-in defaults — ./data locally, /data in Docker (via
# Dockerfile ENV + compose environment:). Uncomment to override.
#OPENFY_DATABASE_URL=sqlite:///./data/openfy.db
#OPENFY_DATA_DIR=./data
#OPENFY_MUSIC_DIR=./data/music
#OPENFY_DOWNLOADS_DIR=./data/downloads
#OPENFY_ARTWORK_DIR=./data/artwork
# Pin SpotiFLAC to a specific version (e.g. 0.7.0). Leave empty for latest.
SPOTIFLAC_PIN_VERSION=
